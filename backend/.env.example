# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key
DEBUG=True

# Database
DB_USER=spt_user
DB_PASSWORD=spt_password
DB_NAME=smart_price_tracker
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://spt_user:spt_password@postgres:5432/smart_price_tracker

# JWT
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@smartpricetracker.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080
