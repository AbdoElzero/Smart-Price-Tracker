# ===================================================
# ملف بيئة للتشغيل المحلي (بدون Docker)
# انسخ هذا الملف وأعد تسميته إلى ".env" داخل مجلد backend
# ===================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key
DEBUG=True

# Database (محلي - PostgreSQL مثبت على جهازك مباشرة)
DB_USER=spt_user
DB_PASSWORD=spt_password
DB_NAME=smart_price_tracker
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://spt_user:spt_password@localhost:5432/smart_price_tracker

# JWT
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Redis / Celery (محلي - Memurai يعمل على نفس منفذ Redis الافتراضي)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google OAuth (اتركها فاضية الآن، سنفعّلها لاحقًا)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Notifications) - اتركها فاضية الآن
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@smartpricetracker.com

# Frontend URL (for CORS) - منفذ Vite الافتراضي عند التشغيل بدون Docker
FRONTEND_URL=http://localhost:5173
